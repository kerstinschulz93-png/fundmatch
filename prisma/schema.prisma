generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model (founders)
// Auth is handled by Supabase - this stores application-specific user data
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  founderProfile FounderProfile?
  applications   Application[]
  successStories SuccessStory[]
}

// Founder profile with business details
model FounderProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  companyName      String?
  stage            Stage    @default(IDEA)
  industries       String[] @default([])
  businessModel    String?
  fundingSoughtMin Int?
  fundingSoughtMax Int?
  teamSize         Int?
  revenue          Int?
  location         String?
  geographicFocus  String?

  // Optional demographics for matching
  demographics Json?
  // Structure: {
  //   genderIdentity?: string
  //   raceEthnicity?: string[]
  //   veteranStatus?: boolean
  //   disabilityStatus?: boolean
  // }

  // For AI matching (Phase 2)
  profileEmbedding String? @db.Text

  onboardingCompleted Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Business stage enum
enum Stage {
  IDEA
  PRE_SEED
  SEED
  SERIES_A
  SERIES_B
  GROWTH
}

// Funding opportunity types
enum OpportunityType {
  GRANT
  INVESTOR
  LOAN
  COMPETITION
  CROWDFUNDING
}

// Funding opportunities
model Opportunity {
  id           String          @id @default(cuid())
  name         String
  type         OpportunityType
  organization String?
  description  String          @db.Text
  amountMin    Int?
  amountMax    Int?

  // Eligibility criteria as JSON for flexibility
  eligibility Json?
  // Structure: {
  //   demographics?: string[]
  //   industries?: string[]
  //   stages?: string[]
  //   locations?: string[]
  //   revenueMin?: number
  //   revenueMax?: number
  // }

  deadline       DateTime?
  applicationUrl String?
  tags           String[]  @default([])
  isVerified     Boolean   @default(false)
  isActive       Boolean   @default(true)

  // For AI matching (Phase 2)
  opportunityEmbedding String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications   Application[]
  successStories SuccessStory[]

  @@index([type])
  @@index([isActive])
  @@index([deadline])
}

// Application tracking status
enum ApplicationStatus {
  SAVED
  RESEARCHING
  APPLYING
  SUBMITTED
  INTERVIEW
  FUNDED
  REJECTED
}

// Application tracking
model Application {
  id            String            @id @default(cuid())
  userId        String
  opportunityId String
  status        ApplicationStatus @default(SAVED)
  notes         String?           @db.Text

  // Document checklist
  documents Json?
  // Structure: {
  //   items: [{ name: string, completed: boolean }]
  // }

  deadlineReminderSent Boolean @default(false)
  submittedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId])
  @@index([userId])
  @@index([status])
}

// Success stories
model SuccessStory {
  id            String  @id @default(cuid())
  userId        String
  opportunityId String?
  title         String
  story         String  @db.Text
  tips          String? @db.Text
  fundingAmount Int?
  isFeatured    Boolean @default(false)
  isPublished   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id])

  @@index([isPublished])
  @@index([isFeatured])
}

// Resource library
model Resource {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  type        ResourceType
  content     String       @db.Text
  summary     String?
  tags        String[]     @default([])
  isPublished Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([isPublished])
}

enum ResourceType {
  GUIDE
  TEMPLATE
  GLOSSARY
  FAQ
}
